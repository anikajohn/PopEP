# from logging import config
import pandas as pd
import glob
import yaml
import re


# ============================================================
# Downstream analysis rules 
# ============================================================

AMPLICONS = list(config["amplicons"].keys())
LOCATIONS = list(config["locations"].keys())

input_dir = config['input_dir']
output_dir = config['output_dir']


wildcard_constraints:
    sample="[^/]+/[^/]+",      # Matches 'sample/batch'
    location="[^/]+",          # Prevents location from grabbing extra slashes
    amplicon="[^/]+"           # Prevents amplicon from grabbing extra slashes

rule all:
    input:
        expand(f"{output_dir}/{{location}}/{{amplicon}}/nextclade_results", location=LOCATIONS, amplicon=AMPLICONS),
        # abundance_analysis outputs
        expand(f"{output_dir}/{{location}}/{{amplicon}}/subclade_abundance/nextclade_metadata_processed.tsv", location=LOCATIONS, amplicon=AMPLICONS),
        # coverage_analysis outputs
        expand(f"{output_dir}/{{location}}/{{amplicon}}/amplicon_coverage/coverage_processed.tsv", location=LOCATIONS, amplicon=AMPLICONS),
        # abundance_analysis_combined_location outputs
        expand(f"{output_dir}/over_all_locations/{{amplicon}}/subclade_abundance/combined_nextclade_metadata_processed.tsv", amplicon=AMPLICONS),
        # coverage_analysis_combined_location outputs
        expand(f"{output_dir}/over_all_locations/{{amplicon}}/amplicon_coverage/combined_coverage_processed.tsv", amplicon=AMPLICONS)

