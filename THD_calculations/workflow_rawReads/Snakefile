        output_plot_byDay=f"{output_dir}/over_all_locations/{{amplicon}}/subclade_abundance/combined_plot_subclade_frequency_byDay.png",
        output_plot_byWeek=f"{output_dir}/over_all_locations/{{amplicon}}/subclade_abundance/combined_plot_subclade_frequency_byWeek.png"
    log:
        f"logs/over_all_locations/{{amplicon}}/abundance_analysis.log"
    params:
        colour_palette=config["colour_palette"]
    shell:
        """
        conda run -n THD_analysis Rscript scripts/abundance_analysis.R \
            -m {input.nextclade_meta_file} \
            -i {input.seq_ids} \
            -f {output.output_file} \
            -d {output.output_plot_byDay} \
            -w {output.output_plot_byWeek} \
            -a \
            -c {params.colour_palette} \
            &> {log}
        """


rule coverage_analysis_combined_location:
