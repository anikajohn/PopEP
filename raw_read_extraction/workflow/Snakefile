# ------------------------------------------------------------
# Aggregation rules (combine samples per location × amplicon)
# ------------------------------------------------------------

rule combine_amp_read_versions:
    """Combine all read versions for a location/amplicon"""
    input:
        individual_fastas=get_location_read_version
    output:
        combined_fasta=f"{output_dir}/{{location}}/{{amplicon}}/combined_amp_reads_versions.fasta"
    log:
        f"logs/{{location}}/{{amplicon}}/combining_amp_read_versions.log"
    shell:
        "cat {input.individual_fastas} > {output.combined_fasta} 2> {log}"


rule combine_amp_read_versions_counts:
    """Combine all read version count files for a location/amplicon"""
    input:
        individual_counts=get_location_read_version_counts
    output:
        combined_counts=f"{output_dir}/{{location}}/{{amplicon}}/combined_amp_read_versions_counts.tsv"
    log:
        f"logs/{{location}}/{{amplicon}}/combining_amp_read_versions_counts.log"
    shell:
        "cat {input.individual_counts} > {output.combined_counts} 2> {log}"

rule combining_amplicon_coverage:
    """Combine all coverage files for a location/amplicon"""
    input:
        individual_cov=get_location_covs
    output:
        combined_cov=f"{output_dir}/{{location}}/{{amplicon}}/combined_amp_coverage.txt"
    log:
        f"logs/{{location}}/{{amplicon}}/combining_regional_coverage.log"
    shell:
        """
        head -n 1 {input.individual_cov[0]} > {output.combined_cov}
        tail -n +2 -q {input.individual_cov} >> {output.combined_cov} 2> {log}
        """