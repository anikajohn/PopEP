def get_location_read_version(wildcards):
    """Get all sample read version files for a location/amplicon combination"""
    samples = get_samples_for_location(wildcards)
    return expand(
        f"{output_dir}/{wildcards.location}/{wildcards.amplicon}/{{sample}}/simulated_amp_reads.fasta",
        sample=samples
    )

def get_location_read_version_counts(wildcards):
    """Get all sample read version count files for a location/amplicon combination"""
    samples = get_samples_for_location(wildcards)
    return expand(
        f"{output_dir}/{wildcards.location}/{wildcards.amplicon}/{{sample}}/read_counts.tsv",
        sample=samples
    )


def get_location_covs(wildcards):
    """Get all sample coverage files for a location/amplicon combination"""
    samples = get_samples_for_location(wildcards)
    return expand(
        f"{output_dir}/{wildcards.location}/{wildcards.amplicon}/{{sample}}/amp_coverage.txt",
        sample=samples
    )

def get_all_basecnt_for_location(wildcards):
    """Get all basecnt files across all amplicons and samples for a location"""
    samples = get_samples_for_location(wildcards)
    return expand(
        f"{output_dir}/{wildcards.location}/{{amplicon}}/{{sample}}/alignments/basecnt.tsv.gz",
        amplicon=AMPLICONS,
        sample=samples
    )


def get_all_fused_bams(wildcards):
    """Get all fused BAM files across all locations (for targeting get_fused_bam)"""
    all_bams = []
    for location in LOCATIONS:
        # Create a simple object with location attribute to satisfy get_samples_for_location
        samples = get_samples_for_location(type('obj', (object,), {'location': location})())
        all_bams.extend(expand(
            f"{output_dir}/{location}/samples/{{sample}}/fused_sorted.bam",
            sample=samples
        ))
    return all_bams


