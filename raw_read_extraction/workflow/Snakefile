# NOT SURE YET, needs to become command line
checkpoint prep_samples_yaml:
    """Generate samples.yaml by filtering timeline for a location"""
    input:
        timeline=f"{output_dir}/timeline.tsv"
    output:
        samples_yaml=f"{output_dir}/{{location}}/samples/samples.yaml"
    params:
        datefrom=config["time_start"],
        dateto=config["time_end"],
        location_name=get_location_name  # e.g., "Zürich (ZH)"
    log:
        f"logs/{{location}}/samples/prep_samples_yaml.log"
    shell:
        """
        python scripts/prep_samples_yaml.py \
            {input.timeline} \
            {params.datefrom} \
            {params.dateto} \
            "{params.location_name}" \
            {output.samples_yaml} \
        &> {log}
        """


rule get_fused_bam:
    """
    input: alignment of reads;
    output: sequences of the amplicons (fused reads) in sam file format
    """
    input:
        bam=get_bam_file
    output:
        sam=temp(f"{output_dir}/{{location}}/samples/{{sample}}/reads.sam"),
        sorted_sam=temp(f"{output_dir}/{{location}}/samples/{{sample}}/reads_sorted.sam"),
        fused_amp=temp(f"{output_dir}/{{location}}/samples/{{sample}}/fused_amp.sam"),
        fused_bam=temp(f"{output_dir}/{{location}}/samples/{{sample}}/fused.bam"),
        fused_length_filt_bam=temp(f"{output_dir}/{{location}}/samples/{{sample}}/fused_length_filt.bam"),
        fused_length_mapq_filt_bam=temp(f"{output_dir}/{{location}}/samples/{{sample}}/fused_length_mapq_filt.bam"),
        fused_sorted_bam_initial=temp(f"{output_dir}/{{location}}/samples/{{sample}}/fused_sorted_initial.bam"),
        fused_indexed_bam_initial=temp(f"{output_dir}/{{location}}/samples/{{sample}}/fused_sorted_initial.bam.bai"),
        fused_sorted_bam=f"{output_dir}/{{location}}/samples/{{sample}}/fused_sorted.bam",
        fused_indexed_bam=f"{output_dir}/{{location}}/samples/{{sample}}/fused_sorted.bam.bai"
    log:
        f"logs/{{location}}/samples/{{sample}}/get_fused_bam.log"
    params:
        len=READ_LEN,
        mapq=READ_MAPQ
    shell:
        """
        # prepare input
        samtools view -h -T {REFERENCE} -t {REFERENCE_INDEX} {input.bam} > {output.sam}
        samtools sort -O sam -n {output.sam} > {output.sorted_sam}

        # run paired_end_read_merger to get sam of fused amplicons)
        paired_end_read_merger --ref {REFERENCE} --output {output.fused_amp} {output.sorted_sam}

        # convert fused sam to bam
        samtools view -bS {output.fused_amp} > {output.fused_bam}

        # filter reads shorter than len (after fusing)
        samtools view -h {output.fused_bam} | awk 'BEGIN {{OFS="\t"}} /^@/ {{print; next}} length($10) >= {params.len}' | samtools view -bS - > {output.fused_length_filt_bam}
        # select reads above mapq mapping quality
        samtools view -h -b -q {params.mapq} {output.fused_length_filt_bam} -o {output.fused_length_mapq_filt_bam}
        # sort and index fused bam
        samtools sort {output.fused_length_mapq_filt_bam} -o {output.fused_sorted_bam_initial}
        samtools index {output.fused_sorted_bam_initial}

        #THIS PROBS ARTIFACT
        # MN908947.3 is the same isolate and identical sequence as accession NC_045512.2 
        # Reheader BAM files if the header is MN908947.3 -> NC_045512.2
        samtools reheader -c 'perl -pe "s/MN908947\.3/NC_045512.2/"' {output.fused_sorted_bam_initial} > {output.fused_sorted_bam}
        samtools index {output.fused_sorted_bam}
        """
    
rule extract_amplicon_reads:
    """
    input: fused reads in bam format; coordinates of amplicon regions
    output: reads mapped to amplicon regions in bam format
    """
    input:
        bam=f"{output_dir}/{{location}}/samples/{{sample}}/fused_sorted.bam"
    output:
        amplicon_bam_unsorted=temp(f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/amp_fused.bam"),
        amplicon_bam=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/amp_fused_sorted.bam",
        amplicon_bam_bai=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/amp_fused_sorted.bam.bai"
    params:
        start=lambda wildcards: get_amplicon_coords(wildcards)["start"],
        end=lambda wildcards: get_amplicon_coords(wildcards)["end"]
    log:
        f"logs/{{location}}/{{amplicon}}/{{sample}}/combine_amplicon_reads.log"
    shell:
        """
        python scripts/filtering_bam.py -i {input.bam} -o {output.amplicon_bam_unsorted} -s {params.start} -e {params.end} 
        samtools sort {output.amplicon_bam_unsorted} -o {output.amplicon_bam}
        samtools index {output.amplicon_bam}
        &> {log}
        """



rule amplicon_coverage:
    """
    input: bam file of amplicon reads
    output: coverage file of amplicon reads
    """
    input:
        bam=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/amp_fused_sorted.bam"
    output:
        coverage=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/amp_coverage.txt"
    log:
        f"logs/{{location}}/{{amplicon}}/{{sample}}/amp_coverage.log"
    params:
        sample = "{sample}",
        amplicon = "{amplicon}"
    shell:
        """
        samtools coverage {input.bam} | \
        awk 'NR==1 {{print "{params.sample}\\t{params.amplicon}\\t" $0; next}} {{print "{params.sample}\\t{params.amplicon}\\t" $0}}' > {output.coverage} \
        2> {log}
        """

rule basecounts:
    input:
        amplicon_bam=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/amp_fused_sorted.bam"
    output:
        BASECNT=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/alignments/basecnt.tsv.gz",
        COVERAGE=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/alignments/coverage.tsv.gz",
        STATS=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/alignments/REF_aln_stats.yaml"
    params:
        NAME="{location}_{amplicon}_{sample}"
    log:
        outfile=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/alignments/basecounts.out.log",
        errfile=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/alignments/basecounts.err.log"
    resources:
        mem_per_cpu=1250
    threads: 1
    shell:
        """
        aln2basecnt --first "1" --basecnt "{output.BASECNT}" --coverage "{output.COVERAGE}" --name "{params.NAME}" --stats "{output.STATS}" "{input.amplicon_bam}" > {log.outfile} 2> >(tee {log.errfile} >&2)
        """


rule generate_mutations_tsv:
    """Generate mutations.tsv from basecnt files for a location"""
    input:
        fasta=REFERENCE,
        basecnt=get_all_basecnt_for_location,
        timeline=f"{output_dir}/timeline.tsv"
    output:
        mutations_tsv=f"{output_dir}/{{location}}/samples/mutations.tsv"
    params:
        basecnt_pattern=lambda wildcards: f"{output_dir}/{wildcards.location}/*/*/*/alignments/basecnt.tsv.gz",
        location_name=get_location_name,
        location_code=get_location_code,
        reference_name=REFERENCE_NAME,
        time_start=config["time_start"],
        time_end=config["time_end"],
        threshold=config["threshold_value"],
        rare_days=config["rare_mutation_limit_days"],
        cov_threshold=config["coverage_threshold"]
    log:
        f"logs/{{location}}/samples/generate_mutations_tsv.log"
    resources:
        mem_per_cpu=50000
    shell:
        """
        python scripts/basecnt_to_mutation_tsv.py \
            --fasta {input.fasta} \
            --reference {params.reference_name} \
            --timeline {input.timeline} \
            --basecnt "{params.basecnt_pattern}" \
            --location "{params.location_name}" \
            --location_code {params.location_code} \
            --time_start {params.time_start} \
            --time_end {params.time_end} \
            --threshold {params.threshold} \
            --rare_mutation_days {params.rare_days} \
            --coverage_threshold {params.cov_threshold} \
            --output {output.mutations_tsv} \
        &> {log}
        """


rule extract_insert_coordinates:
    """Extract amplicon coordinates from BED file"""
    input:
        bed=lambda wildcards: config["amplicons"][wildcards.amplicon]["bedfile"]
    output:
        f"{output_dir}/{{location}}/{{amplicon}}/bed_annotated.tsv"
    run:
        import sys
        sys.path.insert(0, "scripts")
        from load_bed import load_bed
        bed = load_bed(input.bed)
        bed.to_csv(output[0], sep='\t', index=False)


rule make_mut_dict:
    """Create mutation dictionary from mutations.tsv"""
    input:
        mut_tsv=f"{output_dir}/{{location}}/samples/mutations.tsv"
    output:
        f"{output_dir}/{{location}}/samples/mut_dict.yaml"
    resources:
        mem_per_cpu=50000
    run:
        from collections import defaultdict
        import re, json, yaml
        import pandas as pd

        mut_tsv_df = pd.read_csv(input.mut_tsv, sep='\t')
        i = mut_tsv_df['nucleotideMutationFrequency'].first_valid_index()
        mut_dict = mut_tsv_df.loc[i, "nucleotideMutationFrequency"]
        mut_list = list(json.loads(mut_dict).keys())

        mut_list_dict = defaultdict(list)
        pos = lambda x: int(re.search(r"\d+", x).group())
        var = lambda x: re.split(r"\d+", x)[1]

        for m in mut_list:
            mut_list_dict[str(pos(m))].append(var(m))

        with open(output[0], 'w') as file:
            yaml.safe_dump(dict(mut_list_dict), file, default_flow_style=False)


rule make_amplicons_dict:
    """Create amplicons dictionary mapping amplicon regions to mutations"""
    input:
        bedfile=f"{output_dir}/{{location}}/{{amplicon}}/bed_annotated.tsv",
        mut_dict=f"{output_dir}/{{location}}/samples/mut_dict.yaml"
    output:
        f"{output_dir}/{{location}}/{{amplicon}}/amp_dict.yaml"
    log:
        f"logs/{{location}}/{{amplicon}}/make_amplicons_dict.log"
    resources:
        mem_per_cpu=50000
    script:
        "scripts/make_amplicons_dict.py"



rule scanbam:
    """Scan amplicon BAM for mutation co-occurrences (raw counts, not normalised)"""
    input:
        fused_bam=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/amp_fused_sorted.bam",
        fused_bam_bai=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/amp_fused_sorted.bam.bai",
        amplicons_dict=f"{output_dir}/{{location}}/{{amplicon}}/amp_dict.yaml"
    output:
        output=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/cooccurrences_summarized.csv"
    params:
        phred=config["phred_score_threshold"],
        reference=REFERENCE_NAME
    resources:
        mem_per_cpu=50000
    log:
        f"logs/{{location}}/{{amplicon}}/{{sample}}/scanbam.log"
    threads: 4
    script:
        "scripts/scan_bam.py"

