rule generate_amp_read_versions:
    """Reconstruct unique amplicon reads and record raw counts per read version"""
    input:
        csv_file=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/cooccurrences_summarized.csv",
        fasta=REFERENCE,
        amp=f"{output_dir}/{{location}}/{{amplicon}}/amp_dict.yaml",
        bed=lambda wildcards: config["amplicons"][wildcards.amplicon]["bedfile"]
    output:
        fasta=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/simulated_amp_reads.fasta",
        tsv=f"{output_dir}/{{location}}/{{amplicon}}/{{sample}}/read_counts.tsv"
    params:
        sample="{sample}",
        amplicon="{amplicon}",
        location="{location}"
    log:
        f"logs/{{location}}/{{amplicon}}/{{sample}}/simulating_amp_reads.log"
    resources:
        mem_per_cpu=50000
    shell:
        """
        python scripts/simulate_reads.py \
            {input.csv_file} {input.fasta} {input.amp} {input.bed} \
            "{params.sample}" "{params.amplicon}" "{params.location}" \
            {output.fasta} {output.tsv} \
        &> {log}
        """


